{
  "name": "@ework/dsh-computer-use",
  "version": "0.1.0",
  "description": "Bounded computer-use tools with element recovery and explicit result verification",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {"types": "./lib/types/index.d.ts", "default": "./lib/index.js"},
    "./sdk": {"types": "./lib/types/sdk.d.ts", "default": "./lib/sdk.js"},
    "./package.json": "./package.json"
  },
  "files": ["lib", "native", "cordis.patch.yml", "README.md"],
  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}},
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1 || 4.0.5-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.7 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7 || 0.2.1-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {"optional": true},
    "@deepseek-ai/dsh-llm": {"optional": true},
    "@deepseek-ai/dsh-attachment": {"optional": true},
    "@deepseek-ai/dsh-agent": {"optional": true},
    "@deepseek-ai/dsh-session": {"optional": true}
  },
  "dependencies": {"@trycua/cua-driver": "0.28.2"},
  "eworkBuild": {"typesProject": "tsconfig.build.json", "protocolEntries": {"sdk": "src/sdk.ts"}}
}
