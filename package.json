{
  "name": "sherlock",
  "version": "1.6.8",
  "description": "EWork Odyssey local-first desktop knowledge assistant.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "DataElement",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dataelement/dsh-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/dataelement/dsh-desktop/issues"
  },
  "homepage": "https://github.com/dataelement/dsh-desktop#readme",
  "keywords": [
    "sherlock",
    "local-first",
    "knowledge-assistant",
    "harness",
    "electron",
    "desktop",
    "agent"
  ],
  "scripts": {
    "postinstall": "patch-package && node scripts/patch-web-frontend-loading.mjs && node scripts/install-brand-assets.mjs && node scripts/install-pdfjs-assets.mjs && install-electron --no",
    "predev": "node scripts/ensure-local-dependencies.mjs",
    "prebuild": "node scripts/ensure-local-dependencies.mjs && node scripts/prepare-memory-model.mjs",
    "preprepare:bundled-plugin-profile": "node scripts/ensure-local-dependencies.mjs",
    "dev": "npm run build:native:voice && npm run build:native:computer && npm run build:native:youtube && npm run build:native:power && electron-vite dev",
    "build": "npm run build:native:voice && npm run build:native:computer && npm run build:native:youtube && npm run build:native:power && node scripts/patch-web-frontend-loading.mjs && node scripts/install-brand-assets.mjs && node scripts/install-pdfjs-assets.mjs && electron-vite build",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "git:policy:install": "node scripts/install-local-git-policy.mjs",
    "git:formal:verify": "node scripts/verify-formal-git-state.mjs",
    "git:handoff": "node scripts/create-sherlock-session-handoff.mjs",
    "git:integration:preflight": "node scripts/verify-sherlock-integration.mjs",
    "git:integration": "node scripts/manage-sherlock-integration.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fund-service": "vitest run test/financial-routing.test.js test/financial-routing-review.test.js test/fund-research-runtime.test.js test/fund-research-yingmi.test.js test/fund-research-operations.test.js test/fund-data-service.test.js test/fund-data-deployment.test.js test/account-service.test.ts && node scripts/test-fund-data-worker.mjs && node scripts/test-fund-research-operations-worker.mjs && node scripts/test-financial-routing-worker.mjs",
    "fund-service:check": "wrangler deploy --dry-run --config services/fund-data/wrangler.jsonc",
    "fund-service:deploy": "node scripts/deploy-fund-data-service.mjs",
    "package:dir": "npm run build && electron-builder --dir",
    "prepare:bundled-plugin-profile": "node scripts/prepare-bundled-plugin-profile.mjs",
    "package:formal:dir": "npm run prepare:bundled-plugin-profile && npm run build && electron-builder --dir --publish never --config electron-builder.notarized.cjs --config.mac.notarize=false",
    "package:dev:dir": "npm run build && electron-builder --dir --config electron-builder.dev.cjs",
    "package:dev:win": "node scripts/verify-target.mjs win32 x64 && npm run build && electron-builder --win --x64 --publish never --config electron-builder.dev.cjs",
    "package:mac": "npm run build && electron-builder --mac --publish never && npm run verify:package:mac -- --app auto",
    "package:mac:arm64": "node scripts/verify-target.mjs darwin arm64 && npm run build && electron-builder --mac --arm64 --publish never && npm run verify:package:mac -- --app \"dist/mac-arm64/EWork Odyssey.app\"",
    "package:mac:arm64:unsigned-ci": "node scripts/verify-target.mjs darwin arm64 && npm run build && electron-builder --mac --arm64 --publish never && npm run verify:package:mac -- --app \"dist/mac-arm64/EWork Odyssey.app\" --skip-signature",
    "package:mac:x64": "node scripts/verify-target.mjs darwin x64 && npm run build && electron-builder --mac --x64 --publish never && npm run verify:package:mac -- --app \"dist/mac/EWork Odyssey.app\"",
    "package:mac:x64:unsigned-ci": "node scripts/verify-target.mjs darwin x64 && npm run build && electron-builder --mac --x64 --publish never && npm run verify:package:mac -- --app \"dist/mac/EWork Odyssey.app\" --skip-signature",
    "package:mac:notarized:arm64": "node scripts/verify-target.mjs darwin arm64 && npm run prepare:bundled-plugin-profile && npm run build && electron-builder --mac --arm64 --publish never --config electron-builder.notarized.cjs && npm run verify:package:mac -- --app \"dist-notarized/mac-arm64/EWork Odyssey.app\"",
    "verify:package:mac": "node scripts/verify-packaged-macos.mjs",
    "release:cloudflare": "node scripts/publish-cloudflare-release.mjs",
    "release:cloudflare:prune-oldest": "node scripts/prune-oldest-cloudflare-release.mjs",
    "package:win": "node scripts/verify-target.mjs win32 x64 && npm run build && electron-builder --win --x64 --publish never",
    "sync:plugins:to-dev": "node scripts/sync-plugin-profile.mjs formal-to-dev",
    "sync:plugins:to-formal": "node scripts/sync-plugin-profile.mjs dev-to-formal",
    "build:native:voice": "node scripts/build-research-voice.mjs",
    "build:native:youtube": "node scripts/build-youtube-player.mjs",
    "build:native:power": "node scripts/build-power-helper.mjs",
    "fund-service:capabilities": "node scripts/check-fund-research-capabilities.mjs",
    "build:native:computer": "node scripts/prepare-computer-driver.mjs && node scripts/build-computer-stroke.mjs && node scripts/prepare-computer-candidates.mjs",
    "prepare:memory-model": "node scripts/prepare-memory-model.mjs"
  },
  "dependencies": {
    "@blocknote/core": "0.55.0",
    "@blocknote/mantine": "0.55.0",
    "@blocknote/react": "0.55.0",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.7",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.7",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.7",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.7",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.7",
    "@deepseek-ai/dsh-output-retention": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-title-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.7",
    "@deepseek-ai/dsh-spill": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-workflow": "0.1.0-rc.7",
    "@huggingface/tokenizers": "0.2.0",
    "@mantine/core": "8.3.11",
    "@mantine/hooks": "8.3.11",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@trycua/cua-driver": "0.28.2",
    "@univerjs/preset-sheets-core": "1.4.0",
    "@univerjs/preset-sheets-filter": "1.4.0",
    "@univerjs/preset-sheets-sort": "1.4.0",
    "@univerjs/presets": "1.4.0",
    "@xmldom/xmldom": "0.9.12",
    "ajv": "8.20.0",
    "apache-arrow": "18.1.0",
    "cheerio": "^1.2.0",
    "docx": "9.10.0",
    "dsh-computer-backends": "file:packages/dsh-computer-backends",
    "dsh-desktop-market-installer": "file:packages/dsh-desktop-market-installer",
    "dsh-fund-research-runtime": "file:packages/dsh-fund-research-runtime",
    "dsh-integration-runtime": "file:packages/dsh-integration-runtime",
    "dsh-memory-runtime": "file:packages/dsh-memory-runtime",
    "dsh-research-collaboration": "file:packages/dsh-research-collaboration",
    "dsh-research-task-runtime": "file:packages/dsh-research-task-runtime",
    "dsh-web-search-session-model": "file:packages/dsh-web-search-session-model",
    "electron-updater": "^6.8.9",
    "exceljs": "4.4.0",
    "fflate": "0.8.2",
    "node": "24.9.0",
    "onnxruntime-node": "1.31.1",
    "pnpm": "10.34.5",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "7.8.2",
    "sanitize-html": "^2.17.7",
    "sqlite-vec": "0.1.9",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.6",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/sanitize-html": "^2.16.1",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "happy-dom": "^20.11.6",
    "jsdom": "^26.1.0",
    "patch-package": "^8.0.1",
    "pdfjs-dist": "4.10.38",
    "typescript": "5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "4.125.0",
    "yaml": "^2.8.3"
  },
  "overrides": {
    "koffi": "3.1.5"
  },
  "build": {
    "appId": "io.dsh.desktop",
    "productName": "EWork Odyssey",
    "asar": false,
    "npmRebuild": false,
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh_CN",
      "zh-TW",
      "zh_TW"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "!node_modules/pdfjs-dist/**",
      "!node_modules/@napi-rs/canvas/**",
      "!node_modules/@napi-rs/canvas-*/**",
      "package.json",
      "!**/*.map",
      "!**/node_modules/@mistralai/mistralai/src/**"
    ],
    "extraResources": [
      {
        "from": "docs/licenses/peekaboo-MIT.txt",
        "to": "third-party/Peekaboo-MIT.txt"
      },
      {
        "from": "build/figma-generation/LICENSE-react-bits.md",
        "to": "third-party/React-Bits-ShapeGrid-LICENSE.md"
      },
      {
        "from": "build/integration-catalog",
        "to": "integration-catalog"
      },
      {
        "from": "build/app-icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/harness-node-entry.mjs",
        "to": "harness-node-entry.mjs"
      },
      {
        "from": "build/dsh-desktop.patch.yml",
        "to": "dsh-desktop.patch.yml"
      },
      {
        "from": "build/splash.html",
        "to": "splash.html"
      },
      {
        "from": "build/sherlock-logo.svg",
        "to": "sherlock-logo.svg"
      },
      {
        "from": "build/plugin-recovery.html",
        "to": "plugin-recovery.html"
      },
      {
        "from": "skills",
        "to": "sherlock-skills"
      },
      {
        "from": "build/native",
        "to": "native",
        "filter": [
          "research-voice.node",
          "computer-stroke.node",
          "computer-launch.node",
          "computer-capture.node",
          "youtube-player.node",
          "sherlock-power-helper",
          "cua-driver",
          "cua-driver-version.json",
          "cua-driver-MIT.txt",
          "peekaboo",
          "computer-candidates.json"
        ]
      },
      {
        "from": "scripts/macos/update-recovery.cjs",
        "to": "update-recovery.cjs"
      },
      {
        "from": "build/memory-model",
        "to": "memory-model"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.evanarts.com/latest/",
        "useMultipleRangeRequest": false
      }
    ],
    "artifactName": "sherlock-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "EWork Odyssey 需要使用麦克风，将你的语音指令转为研究画布组件。",
        "NSSpeechRecognitionUsageDescription": "EWork Odyssey 使用语音识别将你的指令转成文字，并在研究画布中执行。"
      },
      "entitlements": "build/entitlements.mac.plist"
    },
    "dmg": {
      "format": "UDBZ"
    },
    "win": {
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "sherlock-windows-${arch}-setup.${ext}",
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "afterPack": "scripts/restore-packaged-runtime-patches.mjs"
  }
}
