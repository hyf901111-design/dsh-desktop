{
  "name": "sherlock-fund-data",
  "account_id": "54389c3ac6d28713b36c466807493ada",
  "main": "worker.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "DAILY_RESEARCH_LIMIT": "1000", "CACHE_TTL_SECONDS": "600" },
  "ratelimits": [
    { "name": "FUND_REQUEST_LIMITER", "namespace_id": "2026090701", "simple": { "limit": 20, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [{ "name": "FUND_COORDINATOR", "class_name": "FundResearchCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FundResearchCoordinator"] }],
  "observability": { "enabled": false }
}
