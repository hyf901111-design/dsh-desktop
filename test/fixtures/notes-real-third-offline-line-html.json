    "title": "原位图表验收二",
    "html": "<style>body{margin:0;padding:8px 10px;font:11px/1.5 var(--sherlock-font-sans)}figure{margin:0}svg{display:block;width:100%;height:auto;color:var(--sherlock-text)}svg text{fill:currentColor;font-size:10px}figcaption{white-space:pre-wrap;overflow-wrap:anywhere;color:var(--sherlock-muted)}summary{cursor:pointer}.legend{display:flex;gap:8px;flex-wrap:wrap;margin:4px 0}.legend button{font:inherit;color:inherit;background:transparent;border:0;cursor:pointer}.legend button[aria-pressed=\"false\"]{opacity:.4}.chart-readout{min-height:18px;font-variant-numeric:tabular-nums}.chart-cursor{stroke:var(--sherlock-muted);stroke-dasharray:3 3}.note{margin:6px 0 0;display:flex;flex-direction:column;gap:4px}.note label{font-size:11px;color:var(--sherlock-muted)}.note textarea{font:inherit;color:var(--sherlock-text);background:var(--sherlock-control-bg);border:1px solid var(--sherlock-control-border);border-radius:6px;padding:6px;min-height:56px;resize:vertical}.note textarea:focus{outline:none;border-color:var(--sherlock-control-primary)}.note-status{font-size:10px;color:var(--sherlock-muted);min-height:14px}details table{border-collapse:collapse;margin-top:4px}details th,details td{border:1px solid var(--sherlock-border);padding:3px 10px;font-size:11px;text-align:left}details th{color:var(--sherlock-muted);font-weight:600}details td[data-sherlock-numeric]{font-variant-numeric:tabular-nums}</style><figure><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 660 305\" role=\"img\" tabindex=\"0\" aria-label=\"原位图表验收二（演示数据）；方向键切换数据点\"><line x1=\"55\" x2=\"605\" y1=\"260\" y2=\"260\" stroke=\"var(--sherlock-border)\" stroke-dasharray=\"4 4\"/><text x=\"48\" y=\"264\" text-anchor=\"end\">11.3</text><line x1=\"55\" x2=\"605\" y1=\"205\" y2=\"205\" stroke=\"var(--sherlock-border)\" stroke-dasharray=\"4 4\"/><text x=\"48\" y=\"209\" text-anchor=\"end\">13.1</text><line x1=\"55\" x2=\"605\" y1=\"150\" y2=\"150\" stroke=\"var(--sherlock-border)\" stroke-dasharray=\"4 4\"/><text x=\"48\" y=\"154\" text-anchor=\"end\">15</text><line x1=\"55\" x2=\"605\" y1=\"95\" y2=\"95\" stroke=\"var(--sherlock-border)\" stroke-dasharray=\"4 4\"/><text x=\"48\" y=\"99\" text-anchor=\"end\">16.9</text><line x1=\"55\" x2=\"605\" y1=\"40\" y2=\"40\" stroke=\"var(--sherlock-border)\" stroke-dasharray=\"4 4\"/><text x=\"48\" y=\"44\" text-anchor=\"end\">18.8</text><g data-series-group=\"0\"><polyline points=\"145,213.1578947368421 325,39.99999999999998 505,150\" fill=\"none\" stroke=\"var(--sherlock-chart-1)\" stroke-width=\"2\"/><circle cx=\"145\" cy=\"213.1578947368421\" r=\"3\" fill=\"var(--sherlock-chart-1)\"><title>10月1日 · 演示数据：10</title></circle><circle cx=\"325\" cy=\"39.99999999999998\" r=\"3\" fill=\"var(--sherlock-chart-1)\"><title>10月2日 · 演示数据：20</title></circle><circle cx=\"505\" cy=\"150\" r=\"3\" fill=\"var(--sherlock-chart-1)\"><title>10月3日 · 演示数据：15</title></circle></g><text x=\"145\" y=\"283\" text-anchor=\"middle\">10月1日</text><text x=\"325\" y=\"283\" text-anchor=\"middle\">10月2日</text><text x=\"505\" y=\"283\" text-anchor=\"middle\">10月3日</text><line class=\"chart-cursor\" x1=\"145\" x2=\"145\" y1=\"40\" y2=\"260\"/></svg><div class=\"chart-readout\" role=\"status\"></div><div class=\"legend\"><button type=\"button\" data-chart-series=\"0\" aria-pressed=\"true\" style=\"color:var(--sherlock-chart-1)\">● 演示数据</button></div><figcaption>原位图表验收二（演示数据）\n数据说明：仅演示数据，无真实数据来源，未查询、不引入任何行情或外部数据</figcaption></figure><details><summary>查看全部数据</summary><table><thead><tr><th>日期</th><th>演示数据</th></tr></thead><tbody><tr><td>10月1日</td><td data-sherlock-numeric>10</td></tr><tr><td>10月2日</td><td data-sherlock-numeric>20</td></tr><tr><td>10月3日</td><td data-sherlock-numeric>15</td></tr></tbody></table></details><div class=\"note\"><label for=\"note-input\">备注（随组件保存，重新打开后保留）</label><textarea id=\"note-input\" placeholder=\"输入备注…\"></textarea><div class=\"note-status\" role=\"status\"></div></div><script>(function(){\nvar chart={labels:[\"10月1日\",\"10月2日\",\"10月3日\"],series:[{name:\"演示数据\",values:[10,20,15]}]};\nvar svg=document.querySelector('svg'),readout=document.querySelector('.chart-readout'),cursor=document.querySelector('.chart-cursor'),buttons=[].slice.call(document.querySelectorAll('[data-chart-series]')),groups=[].slice.call(document.querySelectorAll('[data-series-group]'));\nvar selected=0;var visible=chart.series.map(function(){return true});\nfunction select(index){selected=Math.max(0,Math.min(chart.labels.length-1,index));var x=55+540/chart.labels.length*(selected+.5);cursor.setAttribute('x1',x);cursor.setAttribute('x2',x);readout.textContent=chart.labels[selected]+' · '+chart.series.filter(function(_,i){return visible[i]}).map(function(s){return s.name+' '+s.values[selected]+'（演示数据）'}).join(' · ')}\nbuttons.forEach(function(button,i){button.addEventListener('click',function(){if(visible[i]&&visible.filter(Boolean).length===1)return;visible[i]=!visible[i];groups[i].style.display=visible[i]?'':'none';button.setAttribute('aria-pressed',String(visible[i]));select(selected)})});\nsvg.addEventListener('keydown',function(event){var index=event.key==='ArrowLeft'?selected-1:event.key==='ArrowRight'?selected+1:event.key==='Home'?0:event.key==='End'?chart.labels.length-1:null;if(index===null)return;event.preventDefault();select(index)});\nsvg.addEventListener('pointermove',function(event){var rect=svg.getBoundingClientRect();if(rect.width)select(Math.round(((event.clientX-rect.left)/rect.width*660-55)/540*chart.labels.length-.5))});\nselect(0);\nvar input=document.getElementById('note-input'),status=document.getElementById('note-status')||document.querySelector('.note-status');\nvar shared=window.sherlockShared.register({initialState:{note:''},reduce:function(s,a){if(a.type==='setNote'&&typeof a.text==='string'){return{s:s,note:a.text}}return s},render:function(s,ctx){if(input.value!==s.note&&!input.matches(':focus')){input.value=s.note}input.readOnly=!!ctx.readOnly;if(ctx.readOnly){status.textContent='只读状态，备注暂不可编辑';}else{status.textContent='备注随组件保存';}}});\ninput.value='';\ninput.addEventListener('input',function(){shared.dispatch({type:'setNote',text:input.value})});\n})();</script>"
