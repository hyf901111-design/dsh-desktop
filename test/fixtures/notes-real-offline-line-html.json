le cx=\"145\" cy=\"260\" r=\"3\" fill=\"var(--sherlock-chart-1)\"><title>10月1日 · 演示数据：10</title></circle><circle cx=\"325\" cy=\"40\" r=\"3\" fill=\"var(--sherlock-chart-1)\"><title>10月2日 · 演示数据：20</title></circle><circle cx=\"505\" cy=\"186.67\" r=\"3\" fill=\"var(--sherlock-chart-1)\"><title>10月3日 · 演示数据：15</title></circle></g><text x=\"145\" y=\"283\" text-anchor=\"middle\">10月1日</text><text x=\"325\" y=\"283\" text-anchor=\"middle\">10月2日</text><text x=\"505\" y=\"283\" text-anchor=\"middle\">10月3日</text><line class=\"chart-cursor\" x1=\"145\" x2=\"145\" y1=\"40\" y2=\"260\"/></svg><div class=\"chart-readout\" role=\"status\"></div><figcaption>原位图表验收二\n演示数据，无真实数据来源；未查询任何行情或外部数据源，全部交互离线实现。</figcaption></figure><details><summary>查看全部数据</summary><table><thead><tr><th>日期</th><th>数值</th></tr></thead><tbody><tr><td>10月1日</td><td>10</td></tr><tr><td>10月2日</td><td>20</td></tr><tr><td>10月3日</td><td>15</td></tr></tbody></table></details><label class=\"note-label\" for=\"accept-note\">备注</label><textarea id=\"accept-note\" placeholder=\"填写备注，用于保存重开交互验收\"></textarea><div class=\"share-status\" id=\"share-status\"></div><script id=\"chart-data\" type=\"application/json\">{\"labels\":[\"10月1日\",\"10月2日\",\"10月3日\"],\"values\":[10,20,15],\"series\":\"演示数据\"}</script><script>(function(){\nvar chart=JSON.parse(document.getElementById('chart-data').textContent);\nvar svg=document.querySelector('svg'),readout=document.querySelector('.chart-readout'),cursor=document.querySelector('.chart-cursor'),note=document.getElementById('accept-note'),status=document.getElementById('share-status');\nvar dispatch=null;\nfunction select(i){var n=Math.max(0,Math.min(chart.labels.length-1,i));var x=55+540/chart.labels.length*(n+.5);cursor.setAttribute('x1',x);cursor.setAttribute('x2',x);readout.textContent=chart.labels[n]+' · '+chart.series+'：'+chart.values[n];}\nsvg.addEventListener('keydown',function(e){var i=e.key==='ArrowLeft'?-1:e.key==='ArrowRight'?1:e.key==='Home'?-99:e.key==='End'?99:0;if(i===0)return;e.preventDefault();if(i===-99){select(0);return;}if(i===99){select(chart.labels.length-1);return;}select((readout._i||0)+i);readout._i=(readout._i||0)+i;});\nsvg.addEventListener('pointermove',function(e){var r=svg.getBoundingClientRect();if(!r.width)return;var n=Math.round(((e.clientX-r.left)/r.width*660-55)/540*chart.labels.length-.5);readout._i=n;select(n);});\nvar initial={note:'',selected:0};\nvar shared=window.sherlockShared?window.sherlockShared.register({initialState:initial,reduce:function(s,a){if(a.type==='setNote'){return{note:String(a.value==null?'':a.value).slice(0,2000),selected:s.selected};}if(a.type==='selectPoint'){return{note:s.note,selected:Math.max(0,Math.min(chart.labels.length-1,a.index))};}return s;},render:function(s,ctx){if(note.value!==(s.note||'')){note.value=s.note||'';}readout._i=s.selected||0;select(s.selected||0);note.disabled=!!ctx.readOnly;status.textContent=ctx.connected?(ctx.readOnly?'共享状态已连接（只读）':'共享状态已连接'):'共享状态未连接';}}):null;\nif(shared){dispatch=function(a){shared.dispatch(a);};svg.addEventListener('keydown',function(e){if(e.key==='ArrowLeft')dispatch({type:'selectPoint',index:(shared._sel||0)-1});if(e.key==='ArrowRight')dispatch({type:'selectPoint',index:(shared._sel||0)+1});if(e.key==='Home')dispatch({type:'selectPoint',index:0});if(e.key==='End')dispatch({type:'selectPoint',index:chart.labels.length-1});});svg.addEventListener('pointermove',function(e){var r=svg.getBoundingClientRect();if(!r.width)return;var n=Math.round(((e.clientX-r.left)/r.width*660-55)/540*chart.labels.length-.5);shared._sel=n;dispatch({type:'selectPoint',index:n});});note.addEventListener('input',function(){dispatch({type:'setNote',value:note.value});});}else{status.textContent='共享状态通道不可用，备注仅本端临时显示';note.addEventListener('input',function(){});}\nselect(0);\n})();</script>"
