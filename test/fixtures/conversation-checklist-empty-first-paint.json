r num=document.createElement(\"strong\");num.textContent=String(done);var t2=document.createElement(\"span\");t2.textContent=\" / \"+s.items.length+\" 项\";counterEl.append(t1,num,t2);var locked=!!(ctx.readOnly||!ctx.connected);rows.forEach(function(r){r.box.disabled=locked;});}});rows.forEach(function(r,i){r.box.addEventListener(\"change\",function(){shared.dispatch({type:\"toggle\",index:i});});});})();</script></body></html>"
